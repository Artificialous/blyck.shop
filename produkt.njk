---
pagination:
  data: collections.productsWithDetailPage
  size: 1
  alias: product
layout: layout.njk
navActive: arbeitsplatz
permalink: "produkt-{{ product.slug }}.html"
eleventyComputed:
  title: "{{ product.title }} — BLYCK"
  description: "{{ product.lead or product.shortDesc }}"
  ogTitle: "{{ product.title }} — BLYCK"
  ogDescription: "{{ product.lead or product.shortDesc }}"
  permalinkPath: "produkt-{{ product.slug }}.html"
---
<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="index.html">Start</a>
    <svg class="ic"><use href="#i-chev-r2"/></svg>
    <a href="index.html#empfehlungen">{{ product.categoryKey | catLabel }}</a>
    <svg class="ic"><use href="#i-chev-r2"/></svg>
    <strong>{{ product.title }}</strong>
  </nav>
</div>

<!-- ==================== PRODUKT-DETAIL ==================== -->
<section class="section" id="{{ product.id }}" data-id="{{ product.id }}" data-clicks="{{ product.baseClicks }}">
  <div class="container pd__grid">

    {#- Jedes Bild bringt seine eigene Groesse/Position fuer die Detailseite
        mit (Feld "images" ist eine Liste von {src, zoom, moveX, moveY}).
        Beim Klick auf eine Miniatur uebernimmt das JS deren data-Attribute
        auf das Hauptbild, damit der Zuschnitt mitwechselt statt haengen
        zu bleiben. -#}
    {%- set mainImg = product.images[0] %}
    {%- set mainImgStyle = 'transform:translate(' ~ (mainImg.moveX if mainImg.moveX is defined else 0) ~ '%, ' ~ (mainImg.moveY if mainImg.moveY is defined else 0) ~ '%) scale(' ~ ((mainImg.zoom if mainImg.zoom is defined else 100) / 100) ~ ')' %}
    <div class="pd__gallery">
      <div class="pd__media">
        {%- if product.images and product.images.length %}<img id="pdMainImage" src="{{ mainImg.src }}" alt="{{ product.title }}" loading="lazy" style="{{ mainImgStyle }}">{% else %}<svg class="ph"><use href="#{{ product.icon }}"/></svg>{% endif %}
      </div>
      {%- if product.images and product.images.length > 1 %}
      <div class="pd__thumbs" role="tablist" aria-label="Weitere Produktfotos">
        {%- for img in product.images %}
        {%- set imgZoom = img.zoom if img.zoom is defined else 100 %}
        {%- set imgMoveX = img.moveX if img.moveX is defined else 0 %}
        {%- set imgMoveY = img.moveY if img.moveY is defined else 0 %}
        <button type="button" class="pd__thumb{% if loop.first %} is-active{% endif %}" data-full="{{ img.src }}" data-zoom="{{ imgZoom }}" data-move-x="{{ imgMoveX }}" data-move-y="{{ imgMoveY }}" aria-label="Bild {{ loop.index }} anzeigen">
          <img src="{{ img.src }}" alt="" loading="lazy" style="transform:translate({{ imgMoveX }}%, {{ imgMoveY }}%) scale({{ imgZoom / 100 }})">
        </button>
        {%- endfor %}
      </div>
      {%- endif %}
    </div>

    <div class="pd__info">
      <p class="pd__cat">{{ product.categoryKey | catLabel }}</p>
      <h1 class="pd__title">{{ product.title }}</h1>
      <p class="pd__lead">{{ product.lead }}</p>

      <p class="pd__pop pop"><svg class="ic ic--14"><use href="#i-click"/></svg><span data-clickcount="{{ product.id }}">{{ product.baseClicks | deNumber }}</span> Klicks diesen Monat</p>

      <p class="pd__price">{% if product.oldPrice %}<del>€ {{ product.oldPrice }}</del> {% endif %}€ {{ product.price }}</p>
      <p class="pd__price-note">Preis kann abweichen · Stand {{ product.priceDate }}</p>

      <div class="pd__actions">
        <a class="btn btn--primary" href="{{ product.amazonLink or '#' }}" rel="nofollow sponsored noopener" data-offer="{{ product.id }}">Zum Angebot bei Amazon</a>
        <button class="wish pd__wish" type="button" data-wish="{{ product.id }}" aria-label="Zur Merkliste hinzufügen">
          <svg class="ic ic--18"><use href="#i-heart"/></svg>
        </button>
      </div>
      <p class="disclosure">Werbung · Enthält Affiliate-Links</p>
    </div>
  </div>

  {%- if product.pros.length or product.cons.length %}
  <div class="container">
    <div class="proscons">
      <div class="proscons__col">
        <p class="proscons__head">Vorteile</p>
        <ul class="proscons__list">
          {%- for item in product.pros %}
          <li><svg class="ic ic--14"><use href="#i-check"/></svg>{{ item }}</li>
          {%- endfor %}
        </ul>
      </div>
      <div class="proscons__col">
        <p class="proscons__head">Nachteile</p>
        <ul class="proscons__list proscons__list--con">
          {%- for item in product.cons %}
          <li><svg class="ic ic--14"><use href="#i-minus"/></svg>{{ item }}</li>
          {%- endfor %}
        </ul>
      </div>
    </div>
  </div>
  {%- endif %}

  <div class="container">
    <h2 class="pd__section-title">Das könnte dir auch gefallen</h2>
    <div class="grid grid--3">
      {%- for p in product | relatedProducts(collections.productsData) %}
      {% include "product-card.njk" %}
      {%- endfor %}
    </div>
    <p class="disclosure disclosure--center">Werbung · Enthält Affiliate-Links</p>
  </div>
</section>
